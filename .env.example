# Environment Configuration for SENTINEL
# Cloud & Enterprise Attack Surface Intelligence Platform

# Application Runtime
NODE_ENV=development
PORT=3000
SERVER_ID=web01
APP_VERSION=1.0.0

# Database Persistence
# Mode can be 'pg' (PostgreSQL via DATABASE_URL) or 'pglite' (embedded/file-backed PostgreSQL for local dev/testing)
DB_MODE=pglite
DATABASE_URL=postgresql://sentinel:sentinel_password@localhost:5432/sentinel
PGLITE_DATA_DIR=../.sentinel_pgdata

# Security & Session Configuration
SESSION_SECRET=change_this_to_a_64_byte_cryptographic_secret_in_production
SESSION_COOKIE_NAME=sentinel_sid
SESSION_TTL_HOURS=12
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default Authorized Domains (comma-separated bootstrap list)
DEFAULT_AUTHORIZED_DOMAINS=example.com,iana.org,nist.gov,cloudflare.com,shodan.io

# External Intelligence Providers
CRTSH_BASE_URL=https://crt.sh
CRTSH_TIMEOUT_MS=15000

CLOUDFLARE_DOH_URL=https://cloudflare-dns.com/dns-query
CLOUDFLARE_TIMEOUT_MS=8000

SHODAN_INTERNETDB_URL=https://internetdb.shodan.io
SHODAN_TIMEOUT_MS=8000

NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
NVD_TIMEOUT_MS=12000
NVD_RATE_LIMIT_DELAY_MS=2000
