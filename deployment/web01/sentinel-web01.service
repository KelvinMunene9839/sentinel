[Unit]
Description=SENTINEL Attack Surface Intelligence Platform (Web01)
After=network.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel/backend
EnvironmentFile=/etc/sentinel/web01.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
