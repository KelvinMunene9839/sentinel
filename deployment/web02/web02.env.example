# Web02 Production Environment Configuration
NODE_ENV=production
PORT=3000
SERVER_ID=web02
APP_VERSION=1.0.0

# Shared External PostgreSQL Persistence (Identical database shared with Web01)
DB_MODE=pg
DATABASE_URL=postgresql://sentinel:CHANGE_ME_DB_PASSWORD@10.0.10.20:5432/sentinel

# Security & Session Configuration (Shared across Web01 and Web02)
SESSION_SECRET=CHANGE_ME_TO_64_BYTE_HEX_SECRET_SHARED_ACROSS_WEB01_AND_WEB02
SESSION_COOKIE_NAME=sentinel_sid
SESSION_TTL_HOURS=12
CORS_ALLOWED_ORIGINS=https://sentinel.example.com,http://10.0.10.10

# Authorized Reconnaissance Scope
DEFAULT_AUTHORIZED_DOMAINS=example.com,iana.org,nist.gov,cloudflare.com,shodan.io

# External Intelligence Providers
CRTSH_BASE_URL=https://crt.sh
CRTSH_TIMEOUT_MS=15000
CLOUDFLARE_DOH_URL=https://cloudflare-dns.com/dns-query
CLOUDFLARE_TIMEOUT_MS=8000
SHODAN_INTERNETDB_URL=https://internetdb.shodan.io
SHODAN_TIMEOUT_MS=8000
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
NVD_TIMEOUT_MS=12000
NVD_RATE_LIMIT_DELAY_MS=1500
