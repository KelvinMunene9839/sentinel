    "test:e2e": "node --test tests/e2e/*.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
